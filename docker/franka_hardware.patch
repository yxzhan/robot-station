+void RobotCommunicationThread::on_fault(const std::exception& e) {
+  RCLCPP_ERROR(logger_, "Control stopped: %s. Restarting it when the robot is idle again (error recovery).",
+               e.what());
+  try {
+    robot_->stopRobot();
+  } catch (const std::exception& stop_error) {
+    RCLCPP_ERROR(logger_, "Stopping control: %s", stop_error.what());
+  }
+  {
+    std::lock_guard<std::mutex> lock(robot_state_mutex_);
+    current_robot_command_mode_ = RobotCommandMode::IDLE;  // (the next switch starts control again)
+  }
+  fault_time_ = std::chrono::steady_clock::now();
+  is_faulted_ = true;
+}
+
+void RobotCommunicationThread::wait_for_recovery() {
+  using namespace std::chrono_literals;
+  try {
+    read();
+  } catch (const std::exception& e) {
+    if (++read_errors_ % 100 == 1) {
+      RCLCPP_ERROR(logger_, "Reading the robot's state: %s", e.what());
+    }
+    std::this_thread::sleep_for(10ms);
+    return;
+  }
+  read_errors_ = 0;
+  // At least a second after the fault (a start that fails at once is not retried in a loop).
+  if (temp_franka_robot_state_.robot_mode == franka::RobotMode::kIdle &&
+      std::chrono::steady_clock::now() - fault_time_ > 1s) {
+    RCLCPP_INFO(logger_, "The robot is idle: restarting control.");
+    is_faulted_ = false;
+  }
+}
