+  cmd_velocity_ = async_hw_velocity_commands_;
+  cmd_cartesian_pose_ = async_hw_cartesian_pose_;
+  cmd_cartesian_velocities_ = async_hw_cartesian_velocities_;
+  cmd_elbow_ = async_hw_elbow_command_;
+}
