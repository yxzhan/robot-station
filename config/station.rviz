# rviz2 for the station (launch/robot.launch.py rviz:=true; or
# `rviz2 -d config/station.rviz`): the Panda from /franka/robot_description and /tf,
# the TF frames (the cameras' too, once calibrated). Add camera images with
# Add > By topic > /cameras/<name>/color/image_raw.
Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.1
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /franka/robot_description
      Visual Enabled: true
      Collision Enabled: false
      Value: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: false
      Show Axes: true
      Marker Scale: 0.3
      Value: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: base
    Frame Rate: 30
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 2.2
      Focal Point: {X: 0.3, Y: 0, Z: 0.4}
      Pitch: 0.45
      Yaw: 0.8
      Name: Current View
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
